# --- Database ---
DATABASE_URL=postgresql://gmb:gmb@localhost:5432/gmb_dev

# --- Auth ---
JWT_SECRET=change_me_to_a_long_random_string
TENANT_TOKEN_ENCRYPTION_KEY=change_me_32_byte_base64_key
# Token lifetimes (all optional — sensible defaults shown).
# JWT_EXPIRES_IN=1h                 # access-token lifetime
# REFRESH_TOKEN_TTL_DAYS=30         # refresh-token lifetime
# EMAIL_VERIFY_TTL_HOURS=48         # email-verification link lifetime
# PASSWORD_RESET_TTL_MINUTES=60     # password-reset link lifetime

# --- Queue (BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- Google Business Profile ---
# OAuth client used to connect a customer's Google Business account.
# Create at console.cloud.google.com > APIs & Services > Credentials
# (OAuth client ID, type "Web application"), then enable the
# "Google Business Profile API" for the same project.
#
# The redirect URI below must ALSO be listed under "Authorized redirect URIs"
# on that client, or Google returns redirect_uri_mismatch. Add a localhost
# entry too if you want the flow to work in development.
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_OAUTH_REDIRECT_URI=https://your-app-domain/gmb-connect/callback
# Places API key powering rank grid / leaderboard / battle map.
GOOGLE_PLACES_API_KEY=

# --- AI (optional: features degrade to templates without it) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Override the Claude model used for AI features (optional; a built-in default
# is used when unset).
# ANTHROPIC_MODEL=

# --- Web ---
WEB_URL=http://localhost:3000
API_PORT=3001
# Browser → API base URL. For a SPLIT deploy (web and API on different hosts),
# set this to the API's public origin. Defaults to localhost dev when unset.
# NEXT_PUBLIC_API_URL=https://api.your-app-domain
# Trusted proxy hops in front of the API (load balancer / CDN) so per-IP rate
# limiting sees the real client IP. Default 0 (no proxy) — set 1 behind one LB.
# TRUST_PROXY_HOPS=1
# DNS CNAME target shown in the partner white-label setup screen.
WHITE_LABEL_CNAME_TARGET=app.adgrowly.ca

# --- GMB tuning (optional — worker sweep intervals, defaults shown in ms) ---
# GMB_AUTO_SYNC_INTERVAL_MS=21600000       # 6h
# GMB_AUTO_SYNC_LOCATION_SPACING_MS=2000
# GMB_BRANDED_IMAGE_INCLUDE_PHONE=false
# GMB_POST_PUBLISH_INTERVAL_MS=300000      # 5m
# GMB_RANK_SCHEDULE_INTERVAL_MS=3600000    # 1h
# GMB_REPORT_SCHEDULE_INTERVAL_MS=21600000 # 6h
# GMB_AUTOPILOT_INTERVAL_MS=3600000        # 1h
# PARTNER_INVOICE_INTERVAL_MS=86400000     # 24h

# --- Razorpay top-up (wallet credit purchases) -----------------------------
# Leave blank to disable top-up (the /billing routes then return 503).
# Get keys from the Razorpay Dashboard → Settings → API Keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook signing secret (Dashboard → Settings → Webhooks). The /billing/webhook
# endpoint rejects any request whose HMAC doesn't match.
RAZORPAY_WEBHOOK_SECRET=
# Price per credit in paisa (100 = ₹1/credit).
RAZORPAY_CREDIT_PRICE_PAISA=100

# --- Stripe top-up (alternative gateway) -----------------------------------
# Leave blank to disable. Get the secret key from Stripe Dashboard →
# Developers → API keys. The active gateway (razorpay|stripe) is chosen by the
# super admin at /admin/gateways; both can be configured.
STRIPE_SECRET_KEY=
# Webhook signing secret (Dashboard → Developers → Webhooks).
STRIPE_WEBHOOK_SECRET=
# Price per credit in cents (1 = $0.01/credit).
STRIPE_CREDIT_PRICE_CENTS=1

# --- Email (SMTP) ----------------------------------------------------------
# Without these, auth/invite/receipt emails are skipped (never silently
# "sent"). Also configurable by the super admin at /admin/email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@your-domain
SMTP_FROM_NAME=Adgrowly GMB Suite

# --- Tax invoice identity --------------------------------------------------
# GST is enabled only when a seller GSTIN is present. Gateway totals are treated
# as tax-inclusive, so enabling GST changes the invoice split, not the charge.
INVOICE_SELLER_NAME=Adgrowly
INVOICE_PRODUCT_NAME=GMB Suite
INVOICE_SELLER_EMAIL=billing@your-domain
INVOICE_SELLER_ADDRESS=
INVOICE_SELLER_GSTIN=
# Basis points: 1800 = 18%.
INVOICE_GST_RATE_BPS=1800

# --- Background workers -----------------------------------------------------
# Must be "true" to run the schedulers (autopilot, post publisher, report,
# keyword-rank capture + partner-invoice finalisation). Off by default so a
# bare process doesn't poll.
ENABLE_WORKERS=false

# --- Credit charging -------------------------------------------------------
# Top-ups always credit the wallet. This toggle controls whether AI FEATURES
# SPEND credits: off (default) = AI runs free; "true" = each AI call reserves/
# settles credits and is blocked when the balance can't cover it.
WALLET_BILLING_ENABLED=false

# --- Signups & ops (optional) ----------------------------------------------
# Credits granted to a brand-new workspace on signup (default 100).
# SIGNUP_BONUS_CREDITS=100
# Sentry DSN for server-side error reporting (optional).
# SENTRY_DSN=

# --- Seed accounts (used by `prisma db seed`) ------------------------------
# The seed creates the first super-admin / partner / demo accounts. If you run
# the seed against a PRODUCTION database you MUST set these: the built-in
# defaults use a weak, publicly-known password (Super@1234) that must never
# reach production. Set strong, unique values, then seed.
# SEED_SUPER_EMAIL=admin@your-domain
# SEED_SUPER_PASSWORD=
# SEED_PARTNER_EMAIL=partner@your-domain
# SEED_PARTNER_PASSWORD=
# SEED_EMAIL=demo@your-domain
# SEED_PASSWORD=
